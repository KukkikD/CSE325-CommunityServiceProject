@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor

<PageTitle>Personal Data</PageTitle>

<StatusMessage />

<div class="mb-4">
    <h2 class="h4 mb-2">Personal Data</h2>
    <p class="text-muted mb-0">
        Manage the personal information associated with your account.
    </p>
</div>

<div class="mb-4 p-4 border rounded-3">
    <h3 class="h5 mb-2">Download Your Data</h3>

    <p class="text-muted mb-3">
        Download a copy of the personal data stored with your account.
    </p>

    <form action="Account/Manage/DownloadPersonalData" method="post">
        <AntiforgeryToken />

        <button class="btn btn-primary" type="submit">
            Download My Data
        </button>
    </form>
</div>

<div class="border border-danger rounded-3 p-4">
    <h3 class="h5 text-danger mb-2">Delete Account</h3>

    <p class="mb-2">
        Permanently delete your account and personal data.
    </p>

    <p class="text-danger fw-semibold mb-3">
        This action cannot be undone.
    </p>

    <a href="Account/Manage/DeletePersonalData"
       class="btn btn-danger">
        Delete Account
    </a>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}
