@page "/servicetasks/delete"
@using Microsoft.EntityFrameworkCore
@using CSE325_CommunityServiceProject.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using CSE325_CommunityServiceProject.Data
@inject IDbContextFactory<CSE325_CommunityServiceProject.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager



@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>ServiceTask</h2>
    <hr />
    @if (servicetask is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Title</dt>
            <dd class="col-sm-10">@servicetask.Title</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@servicetask.Description</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">VolunteersNeeded</dt>
            <dd class="col-sm-10">@servicetask.VolunteersNeeded</dd>
        </dl>
       
        <EditForm method="post" Model="servicetask" OnValidSubmit="DeleteServiceTask" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(servicetask is null)">Delete</button> |
            <a href="@($"/serviceopportunities/details?id={servicetask.ServiceOpportunityId}")">
                Back to Opportunity </a>
        </EditForm>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    private ServiceTask? servicetask;

    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateTask).User;
        var userId = UserManager.GetUserId(user);

        using var context = DbFactory.CreateDbContext();
        servicetask = await context.ServiceTasks
        .FirstOrDefaultAsync(t =>
        t.Id == Id && t.ServiceOpportunity.OrganizerUserId == userId);

        if (servicetask is null )
        {
            NavigationManager.NavigateTo("/not-authorized");
            return;
        }

        
    }

    private async Task DeleteServiceTask()
    {
        var opportunityId = servicetask!.ServiceOpportunityId;

        using var context = DbFactory.CreateDbContext();

        context.ServiceTasks.Remove(servicetask);
        await context.SaveChangesAsync();

        NavigationManager.NavigateTo(
            $"/serviceopportunities/details?id={opportunityId}");
    }
}
