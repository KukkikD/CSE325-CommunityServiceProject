@page "/servicetasks/edit"
@using Microsoft.EntityFrameworkCore
@using CSE325_CommunityServiceProject.Models
@inject IDbContextFactory<CSE325_CommunityServiceProject.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using CSE325_CommunityServiceProject.Data
@inject UserManager<ApplicationUser> UserManager
@attribute [Authorize]

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>ServiceTask</h2>
<hr />
@if (ServiceTask is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="ServiceTask" OnValidSubmit="UpdateServiceTask" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <input type="hidden" name="ServiceTask.Id" value="@ServiceTask.Id" />
                <div class="mb-3">
                    <label for="title" class="form-label">Title:</label>
                    <InputText id="title" @bind-Value="ServiceTask.Title" class="form-control" />
                    <ValidationMessage For="() => ServiceTask.Title" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description:</label>
                    <InputText id="description" @bind-Value="ServiceTask.Description" class="form-control" />
                    <ValidationMessage For="() => ServiceTask.Description" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="volunteersneeded" class="form-label">VolunteersNeeded:</label>
                    <InputNumber id="volunteersneeded" @bind-Value="ServiceTask.VolunteersNeeded" class="form-control" />
                    <ValidationMessage For="() => ServiceTask.VolunteersNeeded" class="text-danger" />
                </div>
                @* <div class="mb-3">
                    <label for="serviceopportunityid" class="form-label">ServiceOpportunityId:</label>
                    <InputText id="serviceopportunityid" @bind-Value="ServiceTask.ServiceOpportunityId" class="form-control" />
                    <ValidationMessage For="() => ServiceTask.ServiceOpportunityId" class="text-danger" />
                </div> *@
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    @if (ServiceTask is not null)
    {
        <a href="@($"/serviceopportunities/details?id={ServiceTask.ServiceOpportunityId}")">
            Back to Opportunity
        </a>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    [SupplyParameterFromForm]
    private ServiceTask? ServiceTask { get; set; }
    
    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateTask).User;
        var userId = UserManager.GetUserId(user);

        using var context = DbFactory.CreateDbContext();
        ServiceTask ??= await context.ServiceTasks.FirstOrDefaultAsync(t => t.Id == Id && t.ServiceOpportunity.OrganizerUserId == userId);

        if (ServiceTask is null)
        {
            NavigationManager.NavigateTo("/not-authorized");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateServiceTask()
    {
        var user = (await AuthenticationStateTask).User;
        var userId = UserManager.GetUserId(user);
        using var context = DbFactory.CreateDbContext();

        var existingTask = await context.ServiceTasks
            .FirstOrDefaultAsync(t => t.Id == ServiceTask!.Id && ServiceTask.ServiceOpportunity.OrganizerUserId == userId);

        if (existingTask is null)
        {
            NavigationManager.NavigateTo("/not-authorized");
            return;
        }

        // Update only the fields that the user can edit.
        existingTask.Title = ServiceTask!.Title;
        existingTask.Description = ServiceTask.Description;
        existingTask.VolunteersNeeded = ServiceTask.VolunteersNeeded;

        await context.SaveChangesAsync();

        NavigationManager.NavigateTo(
            $"/serviceopportunities/details?id={existingTask.ServiceOpportunityId}");
    }

    
}
