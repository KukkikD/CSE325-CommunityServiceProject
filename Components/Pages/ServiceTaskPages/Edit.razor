@page "/servicetasks/edit"
@using Microsoft.EntityFrameworkCore
@using CSE325_CommunityServiceProject.Models
@inject IDbContextFactory<CSE325_CommunityServiceProject.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using CSE325_CommunityServiceProject.Data
@inject UserManager<ApplicationUser> UserManager
@attribute [Authorize]

<PageTitle>Edit Volunteer Task</PageTitle>

@* Renders Task Edit Form *@
<div class="container py-4">

    @* Wait for the Service Task to be available *@
    @if (ServiceTask is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        @* TITLE BLOCK *@
        <div class="mb-4">
            <p class="text-muted mb-1">Manage Opportunity</p>
            <h1 class="mb-2">Edit Volunteer Task</h1>
            <p class="text-muted">
                Update the task details and volunteer requirements.
            </p>
        </div>

        @* FORM BLOCK *@
        <div class="row">
            <div class="col-lg-7 col-md-9">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h2 class="h4 mb-3">Task Details</h2>

                        <EditForm method="post"
                            Model="ServiceTask"
                            OnValidSubmit="UpdateServiceTask"
                            FormName="edit"
                            Enhance>

                            <DataAnnotationsValidator />

                            @* Form Title Input *@
                            <input type="hidden"
                                name="ServiceTask.Id"
                                value="@ServiceTask.Id" />

                            <div class="mb-3">
                                <label for="title"
                                    class="form-label">
                                        Title
                                </label>

                                <InputText id="title"
                                    @bind-Value="ServiceTask.Title"
                                    class="form-control" />

                                <ValidationMessage For="() => ServiceTask.Title"
                                    class="text-danger" />
                            </div>

                            @* Form Description Input *@
                            <div class="mb-3">
                                <label for="description"
                                        class="form-label">
                                    Description
                                </label>

                                <InputText id="description"
                                    @bind-Value="ServiceTask.Description"
                                    class="form-control" />

                                <ValidationMessage For="() => ServiceTask.Description"
                                    class="text-danger" />
                            </div>

                            @* Form Volunteers Needed Input *@
                            <div class="mb-4">
                                <label for="volunteersneeded"
                                    class="form-label">
                                        Volunteers Needed
                                </label>

                                <InputNumber id="volunteersneeded"
                                    @bind-Value="ServiceTask.VolunteersNeeded"
                                    class="form-control"
                                    min="1" />

                                <ValidationMessage For="() => ServiceTask.VolunteersNeeded"
                                    class="text-danger" />

                                <div class="form-text">
                                    Enter the number of volunteers needed for this task.
                                </div>
                            </div>

                            @* Submit Button / Cancel Button *@
                            <div class="d-flex flex-wrap gap-2">

                                <button type="submit"
                                    class="btn btn-primary">
                                        Save Changes
                                </button>

                                <a href="@($"/serviceopportunities/details?id={ServiceTask.ServiceOpportunityId}")"
                                    class="btn btn-outline-secondary">
                                        Cancel
                                </a>

                            </div>

                        </EditForm>

                    </div>
                </div>
            </div>
        </div>
    }

</div>

@code {
    @* Parameters Required *@
    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    [SupplyParameterFromForm]
    private ServiceTask? ServiceTask { get; set; }
    
    @* This method renders the page when opened *@
    protected override async Task OnInitializedAsync()
    {
        @* Retrieve user information from session and store it *@
        var user = (await AuthenticationStateTask).User;
        var userId = UserManager.GetUserId(user);

        @* Creates DB Context, query the Service Tasks from User's Service Opportunity *@
        using var context = DbFactory.CreateDbContext();
        ServiceTask ??= await context.ServiceTasks.FirstOrDefaultAsync(t => t.Id == Id && t.ServiceOpportunity.OrganizerUserId == userId);

        @* If there is no Service Task send to Not Authorized page *@
        if (ServiceTask is null)
            {
                NavigationManager.NavigateTo("/not-authorized");
            }
    }

    @* Update Service Task Method: update data from Form *@
    private async Task UpdateServiceTask()
    {
        @* Retrieve user information from session and store it *@
        var user = (await AuthenticationStateTask).User;
        var userId = UserManager.GetUserId(user);

        @* Creates DB Context *@
        using var context = DbFactory.CreateDbContext();

        @* Retrieve Service Task form database *@
        var existingTask = await context.ServiceTasks
            .FirstOrDefaultAsync(t =>
            t.Id == ServiceTask!.Id &&
            t.ServiceOpportunity.OrganizerUserId == userId);

        @* Handles unfound Service Task *@
        if (existingTask is null)
            {
                NavigationManager.NavigateTo("/not-authorized");
                return;
            }

        @* Update only the fields that the user can edit. *@
        existingTask.Title = ServiceTask!.Title;
        existingTask.Description = ServiceTask.Description;
        existingTask.VolunteersNeeded = ServiceTask.VolunteersNeeded;

        @* Save into database *@
        await context.SaveChangesAsync();

        @* Redirect to Service Opportunity page *@
        NavigationManager.NavigateTo(
            $"/serviceopportunities/details?id={existingTask.ServiceOpportunityId}");
    }

    
}
