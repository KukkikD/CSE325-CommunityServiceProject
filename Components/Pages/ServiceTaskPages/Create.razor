@page "/servicetasks/create/{serviceId:guid}"
@using Microsoft.EntityFrameworkCore
@using CSE325_CommunityServiceProject.Models
@inject IDbContextFactory<CSE325_CommunityServiceProject.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using CSE325_CommunityServiceProject.Data
@inject UserManager<ApplicationUser> UserManager

@attribute [Authorize]

<PageTitle>Add Volunteer Task</PageTitle>

@* Renders Task Create Form *@
<div class="container py-4">

    @* TITLE BLOCK *@
    <div class="mb-4">
        <p class="text-muted mb-1">Manage Opportunity</p>
        <h1 class="mb-2">Add a Volunteer Task</h1>
        <p class="text-muted">
            Create a task that volunteers can sign up to help with.
        </p>
    </div>

    @* FORM BLOCK *@
    <div class="row">
        <div class="col-lg-7 col-md-9">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="h4 mb-3">Task Details</h2>

                    <EditForm method="post"
                              Model="ServiceTask"
                              OnValidSubmit="AddServiceTask"
                              FormName="create"
                              Enhance>

                        <DataAnnotationsValidator />

                        @* Form Title Input *@
                        <div class="mb-3">
                            <label for="title"
                                   class="form-label">
                                Title
                            </label>

                            <InputText id="title"
                                       @bind-Value="ServiceTask.Title"
                                       class="form-control"
                                       placeholder="Example: Set up tables and chairs" />

                            <ValidationMessage For="() => ServiceTask.Title"
                                               class="text-danger" />
                        </div>

                        @* Form Description Input *@
                        <div class="mb-3">
                            <label for="description"
                                   class="form-label">
                                Description
                            </label>

                            <InputText id="description"
                                       @bind-Value="ServiceTask.Description"
                                       class="form-control"
                                       placeholder="Describe what volunteers will help with" />

                            <ValidationMessage For="() => ServiceTask.Description"
                                               class="text-danger" />
                        </div>

                        @* Form Volunteers Needed Input *@
                        <div class="mb-4">
                            <label for="volunteersneeded"
                                   class="form-label">
                                Volunteers Needed
                            </label>

                            <InputNumber id="volunteersneeded"
                                         @bind-Value="ServiceTask.VolunteersNeeded"
                                         class="form-control"
                                         min="1" />

                            <ValidationMessage For="() => ServiceTask.VolunteersNeeded"
                                               class="text-danger" />

                            <div class="form-text">
                                Enter the number of volunteers needed for this task.
                            </div>
                        </div>

                        @* Submit Button / Cancel Button *@
                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Add Task
                            </button>

                            <a href="@($"/serviceopportunities/details?id={serviceId}")"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </EditForm>

                </div>
            </div>

        </div>
    </div>
</div>

@code {
    @* PARAMETERS *@
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    [SupplyParameterFromForm]
    private ServiceTask ServiceTask { get; set; } = default!;
    [Parameter] public Guid serviceId { get; set; } = default!;


    @* This method renders the page when opened *@
    protected override async Task OnInitializedAsync()
    {
        @* Retrieve user information from session and store it *@
        var user = (await AuthenticationStateTask).User;
        var userId = UserManager.GetUserId(user);

        @* Initialize DB Context *@
        using var context = DbFactory.CreateDbContext();

        @* Load Service Opportunity data *@
        ServiceOpportunity serviceopportunity = await context.ServiceOpportunities.FirstOrDefaultAsync(m => m.Id == serviceId && m.OrganizerUserId == userId);        
        
        @* If there is no Service Opportunity,
        then send to Not Authorized page *@
        if (serviceopportunity is null)
        {
            NavigationManager.NavigateTo("/not-authorized");
            return;
        }
        ServiceTask ??= new();
    }

    @* Create Service Task Method: create data from Form *@
    private async Task AddServiceTask()
    {
        @* Retrieve user information from session and store it *@
        var user = (await AuthenticationStateTask).User;
        var userId = UserManager.GetUserId(user);

        @* Creates DB Context *@
        using var context = DbFactory.CreateDbContext();

        @* Load Service Opportunity data *@
        ServiceOpportunity serviceopportunity = await context.ServiceOpportunities.FirstOrDefaultAsync(m => m.Id == serviceId && m.OrganizerUserId == userId);

        @* Handles unfound Service Opportunity *@
        if (serviceopportunity is null)
        {
            NavigationManager.NavigateTo("/not-authorized");
            return;
        }

        @* Load Service Opportunity *@
        ServiceTask.ServiceOpportunity = serviceopportunity;

        @* Save the record on database *@
        context.ServiceTasks.Add(ServiceTask);
        await context.SaveChangesAsync();

        @* Redirect to Service Opportunity page *@
        NavigationManager.NavigateTo(
            $"/serviceopportunities/details?id={serviceId}");
    }
}
