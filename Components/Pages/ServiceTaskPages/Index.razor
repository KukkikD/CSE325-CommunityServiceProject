@page "/servicetasks"

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using CSE325_CommunityServiceProject.Models
@using CSE325_CommunityServiceProject.Data
@implements IAsyncDisposable
@inject IDbContextFactory<CSE325_CommunityServiceProject.Data.ApplicationDbContext> DbFactory

<PageTitle>Project Tasks</PageTitle>

<h1>Project Tasks</h1>

@* Service Task Grid: Renders the Service Tasks from serviceId provided on Query Parameter *@
<QuickGrid Class="table" Items="@context.ServiceTasks.Where(p => p.ServiceOpportunityId == serviceId)">
    <PropertyColumn Property="servicetask => servicetask.Title" />
    <PropertyColumn Property="servicetask => servicetask.Description" />
    <PropertyColumn Property="servicetask => servicetask.VolunteersNeeded" />
    <PropertyColumn Property="servicetask => servicetask.ServiceOpportunityId" />

    <TemplateColumn Context="servicetask">
        <a href="@($"servicetasks/edit?id={servicetask.Id}")">Edit</a> |
        <a href="@($"servicetasks/details?id={servicetask.Id}")">Details</a> |
        <a href="@($"servicetasks/{serviceId}/delete?id={servicetask.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    @* serviceId:Guid -> Query Parameter related to Service Opportunity *@
    [SupplyParameterFromQuery]
    public Guid serviceId { get; set; }

    @* Database context *@
    private ApplicationDbContext context = default!;

    @* When render the page, this method creates the database context *@
    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    @* Close database connection *@
    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
