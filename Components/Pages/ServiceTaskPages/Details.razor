@page "/servicetasks/details"
@using Microsoft.EntityFrameworkCore
@using CSE325_CommunityServiceProject.Models
@inject IDbContextFactory<CSE325_CommunityServiceProject.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>ServiceTask</h2>
    <hr />
    @if (servicetask is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Title</dt>
            <dd class="col-sm-10">@servicetask.Title</dd>
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@servicetask.Description</dd>
            <dt class="col-sm-2">VolunteersNeeded</dt>
            <dd class="col-sm-10">@servicetask.VolunteersNeeded</dd>
            <dt class="col-sm-2">ServiceOpportunityId</dt>
            <dd class="col-sm-10">@servicetask.ServiceOpportunityId</dd>
        </dl>
        <div>
            <a href="@($"/servicetasks/edit?id={servicetask.Id}")">Edit</a> |
            <a href="@($"/servicetasks?serviceId={servicetask.ServiceOpportunityId}")">Back to List</a>
        </div>
    }
</div>

@code {
    private ServiceTask? servicetask;

    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        servicetask = await context.ServiceTasks.FirstOrDefaultAsync(m => m.Id == Id);

        if (servicetask is null)
        {
            NavigationManager.NotFound();
        }
    }
}
