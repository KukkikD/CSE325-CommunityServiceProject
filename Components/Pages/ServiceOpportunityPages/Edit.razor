@page "/serviceopportunities/edit"
@using Microsoft.EntityFrameworkCore
@using CSE325_CommunityServiceProject.Models

@inject IDbContextFactory<CSE325_CommunityServiceProject.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using CSE325_CommunityServiceProject.Data

@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager


<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Edit Opportunity</h2>
<hr />
@if (ServiceOpportunity is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="ServiceOpportunity" OnValidSubmit="UpdateServiceOpportunity" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="ServiceOpportunity.Id" value="@ServiceOpportunity.Id" />
                <div class="mb-3">
                    <label for="title" class="form-label">Title:</label>
                    <InputText id="title" @bind-Value="ServiceOpportunity.Title" class="form-control" />
                    <ValidationMessage For="() => ServiceOpportunity.Title" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description:</label>
                    <InputText id="description" @bind-Value="ServiceOpportunity.Description" class="form-control" />
                    <ValidationMessage For="() => ServiceOpportunity.Description" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="datetime" class="form-label">Date:</label>
                    <InputDate id="datetime" @bind-Value="ServiceOpportunity.DateTime" class="form-control" />
                    <ValidationMessage For="() => ServiceOpportunity.DateTime" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="location" class="form-label">Location:</label>
                    <InputText id="location" @bind-Value="ServiceOpportunity.Location" class="form-control" />
                    <ValidationMessage For="() => ServiceOpportunity.Location" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="status" class="form-label">Status</label>
                    <InputSelect id="status"
                                @bind-Value="ServiceOpportunity.Status"
                                class="form-control">
                        @foreach (var status in Enum.GetValues<OpportunityStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                    </InputSelect>
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/serviceopportunities">Back to List</a>
</div>

@code {

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    [SupplyParameterFromForm]
    private ServiceOpportunity? ServiceOpportunity { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateTask).User;
        var userId = UserManager.GetUserId(user);

        using var context = DbFactory.CreateDbContext();

        var opportunityId = ServiceOpportunity?.Id ?? Id;

        var savedOpportunity = await context.ServiceOpportunities
            .FirstOrDefaultAsync(o => o.Id == opportunityId);

        if (savedOpportunity is null ||
            savedOpportunity.OrganizerUserId != userId)
        {
            NavigationManager.NotFound();
            return;
        }

        ServiceOpportunity ??= savedOpportunity;

        if (ServiceOpportunity is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateServiceOpportunity()
    {
        var userId = UserManager.GetUserId((await AuthenticationStateTask).User);

        using var context = DbFactory.CreateDbContext();

        var opportunity = await context.ServiceOpportunities
        .FirstOrDefaultAsync(o => o.Id == ServiceOpportunity!.Id);

        if (opportunity is null || opportunity.OrganizerUserId != userId)
        {
            NavigationManager.NotFound();
            return;
        }

        opportunity.Title = ServiceOpportunity.Title;
        opportunity.Description = ServiceOpportunity.Description;
        opportunity.DateTime = ServiceOpportunity.DateTime;
        opportunity.Location = ServiceOpportunity.Location;
        opportunity.Status = ServiceOpportunity.Status;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ServiceOpportunityExists(ServiceOpportunity!.Id))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/serviceopportunities");
    }

    private bool ServiceOpportunityExists(Guid id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.ServiceOpportunities.Any(e => e.Id == id);
    }
}
