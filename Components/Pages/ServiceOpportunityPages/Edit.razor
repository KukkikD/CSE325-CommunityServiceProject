@page "/serviceopportunities/edit"
@using Microsoft.EntityFrameworkCore
@using CSE325_CommunityServiceProject.Models

@inject IDbContextFactory<CSE325_CommunityServiceProject.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using CSE325_CommunityServiceProject.Data

@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager


<PageTitle>Edit Opportunity</PageTitle>

<div class="container py-4">

    <div class="mb-4">
        <p class="text-muted mb-1">Manage Opportunity</p>
        <h1 class="mb-2">Edit Opportunity</h1>
        <p class="text-muted">
            Update the details for this service opportunity.
        </p>
    </div>

    @if (ServiceOpportunity is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="row">
            <div class="col-lg-7 col-md-9">

                <div class="card shadow-sm">
                    <div class="card-body p-4">

                        <h2 class="h4 mb-3">Opportunity Details</h2>

                        <EditForm method="post"
                                  Model="ServiceOpportunity"
                                  OnValidSubmit="UpdateServiceOpportunity"
                                  FormName="edit"
                                  Enhance>

                            <DataAnnotationsValidator />

                            <input type="hidden"
                                   name="ServiceOpportunity.Id"
                                   value="@ServiceOpportunity.Id" />

                            <div class="mb-3">
                                <label for="title"
                                       class="form-label">
                                    Title
                                </label>

                                <InputText id="title"
                                           @bind-Value="ServiceOpportunity.Title"
                                           class="form-control" />

                                <ValidationMessage For="() => ServiceOpportunity.Title"
                                                   class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="description"
                                       class="form-label">
                                    Description
                                </label>

                                <InputText id="description"
                                           @bind-Value="ServiceOpportunity.Description"
                                           class="form-control" />

                                <ValidationMessage For="() => ServiceOpportunity.Description"
                                                   class="text-danger" />
                            </div>

                            <div class="row">

                                <div class="col-md-6 mb-3">
                                    <label for="datetime"
                                           class="form-label">
                                        Date
                                    </label>

                                    <InputDate id="datetime"
                                               @bind-Value="ServiceOpportunity.DateTime"
                                               class="form-control" />

                                    <ValidationMessage For="() => ServiceOpportunity.DateTime"
                                                       class="text-danger" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="status"
                                           class="form-label">
                                        Status
                                    </label>

                                    <InputSelect id="status"
                                                 @bind-Value="ServiceOpportunity.Status"
                                                 class="form-select">

                                        @foreach (var status in Enum.GetValues<OpportunityStatus>())
                                        {
                                            <option value="@status">@status</option>
                                        }

                                    </InputSelect>
                                </div>

                            </div>

                            <div class="mb-4">
                                <label for="location"
                                       class="form-label">
                                    Location
                                </label>

                                <InputText id="location"
                                           @bind-Value="ServiceOpportunity.Location"
                                           class="form-control" />

                                <ValidationMessage For="() => ServiceOpportunity.Location"
                                                   class="text-danger" />
                            </div>
                            @if (errorMessage is not null)
                            {
                                <div class="alert alert-danger" role="alert">@errorMessage</div>
                            }
                            <div class="d-flex flex-wrap gap-2">

                                <button type="submit"
                                        class="btn btn-primary">
                                    Save Changes
                                </button>

                                <a href="/my-opportunities"
                                   class="btn btn-outline-secondary">
                                    Cancel
                                </a>

                            </div>

                        </EditForm>

                    </div>
                </div>

            </div>
        </div>
    }
</div>

@code {

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    [SupplyParameterFromForm]
    private ServiceOpportunity? ServiceOpportunity { get; set; }


    private string? errorMessage;
    protected override async Task OnInitializedAsync()
    {
        // Load only if current user is owner of the opportunity
        var user = (await AuthenticationStateTask).User;
        var userId = UserManager.GetUserId(user);

        using var context = DbFactory.CreateDbContext();

        var opportunityId = ServiceOpportunity?.Id ?? Id;

        var savedOpportunity = await context.ServiceOpportunities
            .FirstOrDefaultAsync(o => o.Id == opportunityId);

        if (savedOpportunity is null)
        {
            NavigationManager.NotFound();
            return;
        }
        if (savedOpportunity.OrganizerUserId != userId)
        {
            NavigationManager.NavigateTo("/not-authorized");
            return;
        }



        ServiceOpportunity ??= savedOpportunity;

        if (ServiceOpportunity is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task UpdateServiceOpportunity()
    {
        // Update only if current user is owner of opportunity
        var userId = UserManager.GetUserId((await AuthenticationStateTask).User);

        using var context = DbFactory.CreateDbContext();

        var opportunity = await context.ServiceOpportunities
        .FirstOrDefaultAsync(o => o.Id == ServiceOpportunity!.Id);

        if (opportunity is null || opportunity.OrganizerUserId != userId)
        {
            NavigationManager.NotFound();
            return;
        }

        opportunity.Title = ServiceOpportunity.Title;
        opportunity.Description = ServiceOpportunity.Description;
        opportunity.DateTime = ServiceOpportunity.DateTime;
        opportunity.Location = ServiceOpportunity.Location;
        opportunity.Status = ServiceOpportunity.Status;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ServiceOpportunityExists(ServiceOpportunity!.Id))
            {
                NavigationManager.NotFound();
                return;
            }
            else
            {
                errorMessage = "We couldn't edit the opportunity. Please try again.";
                return;
            }
        }
        catch (DbUpdateException)
        {
            errorMessage = "We couldn't edit the opportunity. Please try Again.";
            return;
        }

        NavigationManager.NavigateTo(
        $"/serviceopportunities/details?id={ServiceOpportunity!.Id}");
    }

    private bool ServiceOpportunityExists(Guid id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.ServiceOpportunities.Any(e => e.Id == id);
    }
}
