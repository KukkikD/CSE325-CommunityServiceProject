@page "/serviceopportunities/delete"
@using Microsoft.EntityFrameworkCore
@using CSE325_CommunityServiceProject.Models
@inject IDbContextFactory<CSE325_CommunityServiceProject.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using CSE325_CommunityServiceProject.Data

@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager
<PageTitle>Delete Opportunity</PageTitle>

<div class="container py-4">

    <div class="mb-4">
        <p class="text-muted mb-1">Manage Opportunity</p>
        <h1 class="mb-2">Delete Opportunity</h1>
        <p class="text-muted">
            Please review the opportunity before deleting it.
        </p>
    </div>

    @if (serviceopportunity is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="row">
            <div class="col-lg-7 col-md-9">

                <div class="card shadow-sm">
                    <div class="card-body p-4">

                        <h2 class="h4 mb-2">
                            Are you sure you want to delete this opportunity?
                        </h2>

                        <p class="text-danger mb-4">
                            This action cannot be undone.
                        </p>

                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h3 class="h5 mb-1">
                                    @serviceopportunity.Title
                                </h3>

                                <p class="text-muted mb-0">
                                    @serviceopportunity.Description
                                </p>
                            </div>

                            <span class="badge bg-success">
                                @serviceopportunity.Status
                            </span>
                        </div>

                        <hr />

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <strong>Date</strong>
                                <p class="mb-0">
                                    @serviceopportunity.DateTime.ToString("MMMM d, yyyy")
                                </p>
                            </div>

                            <div class="col-md-6 mb-3">
                                <strong>Location</strong>
                                <p class="mb-0">
                                    @serviceopportunity.Location
                                </p>
                            </div>

                            <div class="col-md-6 mb-3">
                                <strong>Organizer</strong>
                                <p class="mb-0">
                                    @(organizer?.UserName ?? "Unknown")
                                </p>
                            </div>

                            <div class="col-md-6 mb-3">
                                <strong>Contact</strong>
                                <p class="mb-0">
                                    @(string.IsNullOrWhiteSpace(organizer?.PhoneNumber)
                                        ? "No phone number provided"
                                        : organizer.PhoneNumber)
                                </p>
                            </div>

                        </div>

                        <hr />

                        <EditForm method="post"
                                  Model="serviceopportunity"
                                  OnValidSubmit="DeleteServiceOpportunity"
                                  FormName="delete"
                                  Enhance>

                            <div class="d-flex flex-wrap gap-2">

                                <button type="submit"
                                        class="btn btn-danger">
                                    Delete Opportunity
                                </button>

                                <a href="/my-opportunities"
                                   class="btn btn-outline-secondary">
                                    Cancel
                                </a>

                            </div>

                        </EditForm>

                    </div>
                </div>

            </div>
        </div>
    }
</div>

@code {

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    private ApplicationUser? organizer;
    private ServiceOpportunity? serviceopportunity;

    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateTask).User;
        var userId = UserManager.GetUserId(user);
        
        using var context = DbFactory.CreateDbContext();
        serviceopportunity = await context.ServiceOpportunities
        .FirstOrDefaultAsync(o =>
            o.Id == Id && o.OrganizerUserId == userId);

        if (serviceopportunity is null)
        {
            NavigationManager.NavigateTo("/not-authorized");
            return;
        }

        organizer = await context.Users
        .FirstOrDefaultAsync(u => u.Id == serviceopportunity.OrganizerUserId);
    }

    private async Task DeleteServiceOpportunity()
    {
         var userId = UserManager.GetUserId(
        (await AuthenticationStateTask).User);

        using var context = DbFactory.CreateDbContext();

        var opportunity = await context.ServiceOpportunities
            .FirstOrDefaultAsync(o =>
                o.Id == Id && o.OrganizerUserId == userId);

        if (opportunity is null)
        {
            NavigationManager.NavigateTo("/not-authorized");
            return;
        }

        context.ServiceOpportunities.Remove(opportunity);
        await context.SaveChangesAsync();

        NavigationManager.NavigateTo("/my-opportunities");
        }
}
