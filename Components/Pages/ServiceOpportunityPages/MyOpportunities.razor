@page "/my-opportunities"

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Authorization
@using CSE325_CommunityServiceProject.Models
@using CSE325_CommunityServiceProject.Data

@attribute [Authorize]

@inject IDbContextFactory<ApplicationDbContext> DbFactory 
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>My Opportunities</PageTitle>

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="mb-1" style="color: #5C6670;">Organizer Dashboard</p>
            <h1 class="mb-1">My Opportunities</h1>
            <p class="mb-0" style="color: #5C6670;">
                Manage the service opportunities you've created.
            </p>
        </div>

        <a href="/serviceopportunities/create"
           class="btn btn-primary">
            + Create Opportunity
        </a>
    </div>

    <!-- This shows a loading message while the opportunities are loading. -->
    @if (isLoading)
    {
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <p class="mb-0">
                    <em>Loading opportunities...</em>
                </p>
            </div>
        </div>
    }
    <!-- This shows a message when the user doesn't have any opportunities available. -->
    else if (createdOpportunities.Count == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5">No opportunities yet</h2>

                <p class="text-muted">
                    You haven't created any service opportunities yet.
                    Create your first opportunity to get started.
                </p>

                <a href="/serviceopportunities/create"
                   class="btn btn-primary">
                    Create Your First Opportunity
                </a>
            </div>
        </div>
    }
    <!-- This shows the user's opportunities in a table. -->
    else
    {
        <div class="card shadow-sm d-none d-md-block">
            <div class="card-body p-0">

                <div class="table-responsive">

                    <QuickGrid Class="table table-hover align-middle mb-0"
                               Items="createdOpportunities.AsQueryable()">

                        <PropertyColumn Property="serviceopportunity => serviceopportunity.Title"
                                        Title="Title" />

                        <PropertyColumn Property="serviceopportunity => serviceopportunity.Description"
                                        Title="Description" />

                        <TemplateColumn Title="Date">
                            <span>
                                @context.DateTime.ToString("MMM d, yyyy")
                            </span>
                        </TemplateColumn>

                        <PropertyColumn Property="serviceopportunity => serviceopportunity.Location"
                                        Title="Location" />

                        <TemplateColumn Title="Status">
                            <span class="badge bg-success">
                                @context.Status
                            </span>
                        </TemplateColumn>

                        <TemplateColumn Title="Actions"
                                        Context="serviceopportunity">

                            <div class="d-flex gap-2 flex-nowrap">

                                <a class="btn btn-sm btn-primary text-nowrap"
                                   href="@($"serviceopportunities/details?id={serviceopportunity.Id}")">
                                    Details
                                </a>

                                <a class="btn btn-sm btn-outline-secondary text-nowrap"
                                   href="@($"serviceopportunities/edit?id={serviceopportunity.Id}")">
                                    Edit
                                </a>

                                <a class="btn btn-sm btn-outline-danger text-nowrap"
                                   href="@($"serviceopportunities/delete?id={serviceopportunity.Id}")">
                                    Delete
                                </a>

                            </div>

                        </TemplateColumn>

                    </QuickGrid>

                </div>

            </div>
        </div>
        
        <!-- Mobile opportunity cards -->
        <div class="d-md-none">
            @foreach (var opportunity in createdOpportunities)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-body p-3">

                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <h2 class="h5 mb-0">
                                @opportunity.Title
                            </h2>

                            <span class="badge bg-success">
                                @opportunity.Status
                            </span>
                        </div>

                        <p class="text-muted mb-3">
                            @opportunity.Description
                        </p>

                        <div class="mb-2">
                            <strong>Date:</strong>
                            @opportunity.DateTime.ToString("MMM d, yyyy")
                        </div>

                        <div class="mb-3">
                            <strong>Location:</strong>
                            @opportunity.Location
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-sm btn-primary"
                            href="@($"serviceopportunities/details?id={opportunity.Id}")">
                                Details
                            </a>

                            <a class="btn btn-sm btn-outline-secondary"
                            href="@($"serviceopportunities/edit?id={opportunity.Id}")">
                                Edit
                            </a>

                            <a class="btn btn-sm btn-outline-danger"
                            href="@($"serviceopportunities/delete?id={opportunity.Id}")">
                                Delete
                            </a>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ServiceOpportunity> createdOpportunities = [];

    private bool isLoading = true;
    // This only shows opportunities created by the user.
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider
        .GetAuthenticationStateAsync();

        var user = await UserManager.GetUserAsync(authState.User);

        if (user is null)
        {
            isLoading = false;
            return;
        }

        using var context = DbFactory.CreateDbContext();

        createdOpportunities = await context.ServiceOpportunities
        .Where(o => o.OrganizerUserId == user.Id)
        .OrderBy(o => o.DateTime)
        .ToListAsync();

        isLoading = false;
    }
}