@page "/my-opportunities"

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Authorization
@using CSE325_CommunityServiceProject.Models
@using CSE325_CommunityServiceProject.Data

@attribute [Authorize]

@inject IDbContextFactory<ApplicationDbContext> DbFactory 
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>My Opportunities </PageTitle>

<h1>My Opportunities</h1>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (createdOpportunities.Count == 0)
        {
            <p>You haven't created any opportunities yet.</p>
        }
        else
        {
            <QuickGrid Class="table" Items="createdOpportunities.AsQueryable()">
                <PropertyColumn Property="serviceopportunity => serviceopportunity.Title" />
                <PropertyColumn Property="serviceopportunity => serviceopportunity.Description" />
                <TemplateColumn Title="Date">
                    <span>@context.DateTime.ToString("MMMM d, yyyy")</span>
                </TemplateColumn>
                
                <PropertyColumn Property="serviceopportunity => serviceopportunity.Location" />
                <PropertyColumn Property="serviceopportunity => serviceopportunity.Status" />

                <TemplateColumn Context="serviceopportunity">
                    <a href="@($"serviceopportunities/edit?id={serviceopportunity.Id}")">Edit</a> |
                    <a href="@($"serviceopportunities/details?id={serviceopportunity.Id}")">Details</a> |
                    <a href="@($"serviceopportunities/delete?id={serviceopportunity.Id}")">Delete</a>
                </TemplateColumn>
            </QuickGrid>
        }
}

@code {
    private List<ServiceOpportunity> createdOpportunities = [];

    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider
        .GetAuthenticationStateAsync();

        var user = await UserManager.GetUserAsync(authState.User);

        if (user is null)
        {
            isLoading = false;
            return;
        }

        using var context = DbFactory.CreateDbContext();

        createdOpportunities = await context.ServiceOpportunities
        .Where(o => o.OrganizerUserId == user.Id)
        .OrderBy(o => o.DateTime)
        .ToListAsync();

        isLoading = false;
    }
}