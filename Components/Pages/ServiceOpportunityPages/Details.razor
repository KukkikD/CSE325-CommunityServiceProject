@page "/serviceopportunities/details"
@using Microsoft.EntityFrameworkCore
@using CSE325_CommunityServiceProject.Models
@using CSE325_CommunityServiceProject.Data
@inject IDbContextFactory<CSE325_CommunityServiceProject.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    @if (serviceopportunity is null)
    {
        <p><em>Loading...</em></p>
    }
    else {

        <h2>@serviceopportunity.Title</h2>
        <hr />

        <dl class="row">
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@serviceopportunity.Description</dd>
            <dt class="col-sm-2">Date</dt>
            <dd class="col-sm-10">@serviceopportunity.DateTime.ToString("MMMM d, yyyy")</dd>
            <dt class="col-sm-2">Location</dt>
            <dd class="col-sm-10">@serviceopportunity.Location</dd>
            <dt class="col-sm-2">Status</dt>
            <dd class="col-sm-10">@serviceopportunity.Status</dd>
            <dt class="col-sm-2">Organizer</dt>
            <dd class="col-sm-10">@(organizer?.UserName ?? "Unknown")</dd>
            <dt class="col-sm-2">Contact</dt>
            <dd class="col-sm-10">@(string.IsNullOrWhiteSpace(organizer?.PhoneNumber) ? "No Phone number provided" : organizer.PhoneNumber)</dd>
        </dl>
        <div>
            <div>
                <a href="@($"/serviceopportunities/edit?id={serviceopportunity.Id}")">Edit</a> |
                <a href="@($"/volunteer/{serviceopportunity.Id}")">Sing Up to Help</a>
            </div>         
        </div>           

        <div class="mt-4">
        <h2>Tasks</h2>

        @if (serviceTaskList.Count == 0)
        {
            <p>
                No tasks have been added yet.
                Add a task so volunteers can sign up.
            </p>
        }
        else
        {
            @foreach (var task in serviceTaskList)
            {
                <div class="mb-3">
                    <h3>@task.Title</h3>

                    @if (!string.IsNullOrWhiteSpace(task.Description))
                    {
                        <p>@task.Description</p>
                    }

                    <p>
                        <strong>Volunteers Needed:</strong>
                        @task.VolunteersNeeded
                    </p>

                    <a href="@($"/servicetasks/edit?id={task.Id}")">
                        Edit
                    </a>
                    <span> | </span>
                    <a href="@($"/servicetasks/delete?id={task.Id}")">
                        Delete
                    </a>
                </div>
            }
        }

        <a class="btn btn-primary mt-2"
        href="@($"/servicetasks/create/{serviceopportunity.Id}")">
            @(serviceTaskList.Count == 0 ? "Add First Task" : "Add New Task")
        </a>
    </div>
    }
</div>

@code {
    
    private ServiceOpportunity? serviceopportunity;
    private ApplicationUser? organizer;

    private List<ServiceTask> serviceTaskList = [];

    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        serviceopportunity = await context.ServiceOpportunities
        .FirstOrDefaultAsync(m => m.Id == Id);

        if (serviceopportunity is null)
        {
            NavigationManager.NotFound();
            return;
        }

        organizer = await context.Users.FirstOrDefaultAsync(u => u.Id == serviceopportunity.OrganizerUserId);

        serviceTaskList = await context.ServiceTasks
        .Where(st => st.ServiceOpportunityId == serviceopportunity.Id)
        .ToListAsync();
    }
}
