@page "/serviceopportunities/details"
@using Microsoft.EntityFrameworkCore
@using CSE325_CommunityServiceProject.Models
@using CSE325_CommunityServiceProject.Data
@inject IDbContextFactory<CSE325_CommunityServiceProject.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using CSE325_CommunityServiceProject.Data
@inject UserManager<ApplicationUser> UserManager

@attribute [Authorize]

<PageTitle>Details</PageTitle>

<PageTitle>Opportunity Details</PageTitle>

<div class="container py-4">
    @if (serviceopportunity is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="mb-4">
            <p class="text-muted mb-1">Community Opportunity</p>
            <h1 class="mb-2">@serviceopportunity.Title</h1>

            <span class="badge bg-success">
                @serviceopportunity.Status
            </span>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <h2 class="h4 mb-3">Opportunity Details</h2>

                <div class="mb-3">
                    <strong>Description</strong>
                    <p class="mb-0">@serviceopportunity.Description</p>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <strong>Date</strong>
                        <p class="mb-0">
                            @serviceopportunity.DateTime.ToString("MMMM d, yyyy")
                        </p>
                    </div>

                    <div class="col-md-6 mb-3">
                        <strong>Location</strong>
                        <p class="mb-0">@serviceopportunity.Location</p>
                    </div>

                    <div class="col-md-6 mb-3">
                        <strong>Organizer</strong>
                        <p class="mb-0">
                            @(organizer?.UserName ?? "Unknown")
                        </p>
                    </div>

                    <div class="col-md-6 mb-3">
                        <strong>Contact</strong>
                        <p class="mb-0">
                            @(string.IsNullOrWhiteSpace(organizer?.PhoneNumber)
                                ? "No phone number provided"
                                : organizer.PhoneNumber)
                        </p>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-2">
                    @if (isOwner)
                    {
                        <a class="btn btn-outline-secondary"
                       href="@($"/serviceopportunities/edit?id={serviceopportunity.Id}")">
                            Edit Opportunity
                        </a>    
                    }
                    

                    <a class="btn btn-primary"
                       href="@($"/volunteer/{serviceopportunity.Id}")">
                        Sign Up to Help
                    </a>
                </div>
            </div>
        </div>

        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h3 mb-1">Volunteer Tasks</h2>
                    <p class="text-muted mb-0">
                        Choose or manage the tasks needed for this opportunity.
                    </p>
                </div>
            </div>

            @if (serviceTaskList.Count == 0)
            {
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h3 class="h5">No tasks yet</h3>

                        <p class="text-muted">
                            Add the first task so volunteers can sign up
                            to help with this opportunity.
                        </p>

                        <a class="btn btn-primary"
                           href="@($"/servicetasks/create/{serviceopportunity.Id}")">
                            Add First Task
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var task in serviceTaskList)
                    {
                        <div class="col-md-6">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h3 class="h5">@task.Title</h3>

                                    @if (!string.IsNullOrWhiteSpace(task.Description))
                                    {
                                        <p class="text-muted">
                                            @task.Description
                                        </p>
                                    }

                                    <p class="mb-3">
                                        <strong>Volunteers Needed:</strong>
                                        @task.VolunteersNeeded
                                    </p>
                                    @if (isOwner)
                                    {
                                        <div class="d-flex gap-2">
                                            <a class="btn btn-sm btn-outline-secondary"
                                            href="@($"/servicetasks/edit?id={task.Id}")">
                                                Edit
                                            </a>

                                            <a class="btn btn-sm btn-outline-danger"
                                            href="@($"/servicetasks/delete?id={task.Id}")">
                                                Delete
                                            </a>
                                        </div>    
                                    }
                                    
                                </div>
                            </div>
                        </div>
                    }
                </div>
                if (isOwner)
                {
                    <div class="mt-3">
                        <a class="btn btn-primary"
                        href="@($"/servicetasks/create/{serviceopportunity.Id}")">
                            Add New Task
                        </a>
                    </div>
                }
                
            }
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    private ServiceOpportunity? serviceopportunity;
    private ApplicationUser? organizer;

    private bool isOwner;
    private List<ServiceTask> serviceTaskList = [];

    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateTask).User;
        var userId = UserManager.GetUserId(user);

        using var context = DbFactory.CreateDbContext();
        serviceopportunity = await context.ServiceOpportunities
        .FirstOrDefaultAsync(m => m.Id == Id);

        if (serviceopportunity is null)
        {
            NavigationManager.NotFound();
            return;
        }

        organizer = await context.Users.FirstOrDefaultAsync(u => u.Id == serviceopportunity.OrganizerUserId);

        if (userId == organizer.Id)
        {
            isOwner = true;
        } else
        {
            isOwner = false;
        }

        serviceTaskList = await context.ServiceTasks
        .Where(st => st.ServiceOpportunityId == serviceopportunity.Id)
        .ToListAsync();
    }
}
