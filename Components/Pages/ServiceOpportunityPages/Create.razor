@page "/serviceopportunities/create"
@using Microsoft.EntityFrameworkCore
@using CSE325_CommunityServiceProject.Models
@inject IDbContextFactory<CSE325_CommunityServiceProject.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using CSE325_CommunityServiceProject.Data
@attribute [Authorize]
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Create Opportunity</PageTitle>

<div class="container py-4">

    <div class="mb-4">
        <p class="text-muted mb-1">Community Connect</p>
        <h1 class="mb-2">Create an Opportunity</h1>
        <p class="text-muted">
            Share a service opportunity with your community.
            After creating it, you can add volunteer tasks.
        </p>
    </div>

    <div class="row">
        <div class="col-lg-7 col-md-9">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="h4 mb-3">Opportunity Details</h2>

                    <EditForm method="post"
                              Model="ServiceOpportunity"
                              OnValidSubmit="AddServiceOpportunity"
                              FormName="create"
                              Enhance>

                        <DataAnnotationsValidator />


                        <div class="mb-3">
                            <label for="title"
                                   class="form-label">
                                Title
                            </label>

                            <InputText id="title"
                                       @bind-Value="ServiceOpportunity.Title"
                                       class="form-control"
                                       placeholder="Example: Community Garden Cleanup" />

                            <ValidationMessage For="() => ServiceOpportunity.Title"
                                               class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <label for="description"
                                   class="form-label">
                                Description
                            </label>

                            <InputText id="description"
                                       @bind-Value="ServiceOpportunity.Description"
                                       class="form-control"
                                       placeholder="Describe the service opportunity" />

                            <ValidationMessage For="() => ServiceOpportunity.Description"
                                               class="text-danger" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="datetime"
                                       class="form-label">
                                    Date
                                </label>

                                <InputDate id="datetime"
                                           @bind-Value="ServiceOpportunity.DateTime"
                                           class="form-control" />

                                <ValidationMessage For="() => ServiceOpportunity.DateTime"
                                                   class="text-danger" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="status"
                                       class="form-label">
                                    Status
                                </label>

                                <InputSelect id="status"
                                             @bind-Value="ServiceOpportunity.Status"
                                             class="form-select">

                                    @foreach (var status in Enum.GetValues<OpportunityStatus>())
                                    {
                                        <option value="@status">@status</option>
                                    }

                                </InputSelect>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="location"
                                   class="form-label">
                                Location
                            </label>

                            <InputText id="location"
                                       @bind-Value="ServiceOpportunity.Location"
                                       class="form-control"
                                       placeholder="Example: Chehalis Community Park" />

                            <ValidationMessage For="() => ServiceOpportunity.Location"
                                               class="text-danger" />
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit"
                                    class="btn btn-primary">
                                Create Opportunity
                            </button>

                            <a href="/my-opportunities"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>

                    </EditForm>

                </div>
            </div>

            <p class="text-muted small mt-3">
                Next step: After creating the opportunity,
                you'll be able to add the tasks volunteers can sign up for.
            </p>

        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    [SupplyParameterFromForm]
    private ServiceOpportunity ServiceOpportunity { get; set; } = default!;

    protected override void OnInitialized()
    {
        ServiceOpportunity ??= new ServiceOpportunity
        {
            DateTime = DateTime.Today
        };
    }

    private async Task AddServiceOpportunity()
    {
        var user = (await AuthenticationStateTask).User;
        ServiceOpportunity.OrganizerUserId =
            UserManager.GetUserId(user)
            ?? throw new InvalidOperationException("Sign in is required.");

        using var context = DbFactory.CreateDbContext();
        context.ServiceOpportunities.Add(ServiceOpportunity);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo(
        $"/serviceopportunities/details?id={ServiceOpportunity.Id}");
    }
}
