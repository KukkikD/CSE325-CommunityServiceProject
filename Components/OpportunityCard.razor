@using Models

<article class="opportunity-card">
    @* Use a shared community image until opportunities support their own images. *@
    <img class="opportunity-image"
         src="images/illustrations/photo_planting.png"
         alt="" />

    <div class="opportunity-content">
        <h3>@Opportunity.Title</h3>

        <div class="opportunity-details">
            <p>
                <img src="images/icons/icon_calendar.png"
                     alt=""
                     aria-hidden="true" />
                @Opportunity.DateTime.ToString("MMM d, yyyy")
            </p>

            <p>
                <img src="images/icons/icon_location.png"
                     alt=""
                     aria-hidden="true" />
                @Opportunity.Location
            </p>
        </div>

        <a class="opportunity-link"
           href="@($"/serviceopportunities/details?id={Opportunity.Id}")"
           aria-label="@($"View details for {Opportunity.Title}")">
            View Details
        </a>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public ServiceOpportunity Opportunity { get; set; } = default!;
}