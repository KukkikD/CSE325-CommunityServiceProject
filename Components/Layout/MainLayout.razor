@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>

        @* Shared footer displayed on every Community Connect page. *@
        <footer class="app-footer">
            <p>
                Community Connect • CSE 325 .NET Software Development • Team 06 • © @DateTime.Now.Year
            </p>
        </footer>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>